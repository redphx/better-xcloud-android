<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/settings_category_stream">

        <SwitchPreference
            android:key="pref_enable_stats"
            android:title="@string/pref_enable_stats"
            android:summary="@string/pref_enable_stats_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_category_input">

        <SwitchPreference
            android:key="pref_gamepad_vibration"
            android:title="@string/pref_gamepad_vibration"
            android:summary="@string/pref_gamepad_vibration_summary"
            android:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_category_advanced">

        <Preference
            android:key="pref_clear_cache"
            android:title="@string/pref_clear_cache"
            android:summary="@string/pref_clear_cache_summary" />

        <SwitchPreference
            android:key="pref_debug_mode"
            android:title="@string/pref_debug_mode"
            android:summary="@string/pref_debug_mode_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
